# Copy to .env for local development.
DATABASE_URL=sqlite:///./journal.db
APP_PASSWORD=change-me
SECRET_KEY=any-long-random-string
COOKIE_SECURE=false
DISPLAY_TZ=America/New_York
# thinkorswim exports times in your platform timezone (default New York)
TOS_TIMEZONE=America/New_York

# Price charts on the trade page: auto | schwab | polygon | yahoo | none
PRICE_PROVIDER=auto
POLYGON_API_KEY=

# Optional Schwab Trader API data source (US retail accounts). Disabled unless all three are set.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
TOKEN_ENCRYPTION_KEY=another-long-random-string
SCHWAB_MAX_LOOKBACK_DAYS=1825
SCHWAB_CHUNK_DAYS=90
SYNC_OVERLAP_DAYS=3

# Optional reminder emails (sent by the scheduled sync)
REMINDER_EMAIL_ENABLED=false
REMINDER_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMPORT_REMINDER_DAYS=3
